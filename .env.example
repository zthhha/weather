# Copy this file to .env and replace placeholders before using real services.
# This graduation project uses the local MySQL root account directly.
MYSQL_DATABASE=weather_dashboard
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_PORT=3306

DB_URL=jdbc:mysql://localhost:3306/weather_dashboard?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me

# QWeather JWT credentials. Do not commit real values.
QWEATHER_KID=
QWEATHER_ISSUER=
QWEATHER_SUBJECT=
# Base64-encoded PKCS#8 Ed25519 private key.
QWEATHER_PRIVATE_KEY=
# Optional: token may not exceed PT24H; refresh defaults to one hour before expiry.
QWEATHER_TOKEN_VALIDITY=PT24H
QWEATHER_REFRESH_THRESHOLD=PT1H
