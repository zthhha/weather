# Copy this file to .env and replace placeholders before using real services.
# This graduation project uses the local MySQL root account directly.
MYSQL_DATABASE=weather_dashboard
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_PORT=3306

DB_URL=jdbc:mysql://localhost:3306/weather_dashboard?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me
QWEATHER_API_KEY=
